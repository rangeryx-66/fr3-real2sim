# Copy to .env and set absolute paths on your Linux host. Do not commit .env.
ISAAC_PYTHON=/absolute/path/to/isaaclab-arena/.venv/bin/python
ISAAC_SITE_PACKAGES=/absolute/path/to/isaaclab-arena/.venv/lib/python3.12/site-packages
ROS_ENV=/absolute/path/to/fr3-real2sim/ros_env
CONDA_SH=/absolute/path/to/conda/etc/profile.d/conda.sh
ANYGRASP_PYTHON=/absolute/path/to/anygrasp-env/bin/python
ANYGRASP_SDK_ROOT=/absolute/path/to/anygrasp_sdk/grasp_detection
MV_SAM3D_ROOT=/absolute/path/to/MV-SAM3D
MV_SAM3D_PYTHON=/absolute/path/to/mv-sam3d-env/bin/python
OFFICIAL_PAYLOAD_ROOT=/absolute/path/to/scalable-real2sim/scalable_real2sim
OFFICIAL_PAYLOAD_PYTHON=/absolute/path/to/official-payload-env/bin/python
ARENA_METADATA_JSON=/absolute/path/to/isaaclab-arena/active_real2sim/outputs/maple/metadata.json
FR3_ASSET_DIRECTORY=/absolute/path/to/fr3-real2sim/assets/arena_complex
PROXY_ON_SCRIPT=
